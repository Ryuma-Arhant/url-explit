# ── Scraping ──────────────────────────────────────────────────────────────────
# Flipkart, Myntra, Croma, Tata CLiQ, AJIO, Reliance Digital, etc. are scraped
# directly from the product page — no key needed.
#
# Apify token — required for:
#   • Amazon links (Amazon blocks direct scraping; uses the junglee/amazon-crawler actor)
#   • Cross-platform comparison (Google search actor)
# Get it: https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# ── LLM — FREE open-source models, pick ONE (or both, Groq tried first) ───────

# Groq: Llama 3.3 70B — 14,400 req/day free, instant key, no card
# https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini 2.0 Flash — 1M tokens/day free, instant key, no card
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Together AI: Llama 3.1 70B — $1 free credit on signup (~500+ audits)
# https://api.together.xyz/settings/api-keys
# TOGETHER_API_KEY=

# ── NVIDIA NIM Embeddings (semantic product similarity) ──────────────────────
# Free: 1000 credits — https://build.nvidia.com  → Get API Key
# Falls back to Jaccard word overlap if not set
# NVIDIA_API_KEY=

# ── MiniMax AI (multi-product comparison analysis) ────────────────────────────
# Free tier — https://platform.minimaxi.com
# Falls back to Groq/Gemini if not set
# MINIMAX_API_KEY=

# ── MongoDB (comparison result persistence) ───────────────────────────────────
# Free cluster: https://cloud.mongodb.com  → Create Free M0
# Falls back to in-memory cache if not set
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/trustlens

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# Deployed frontend origin allowed by CORS (e.g. https://trustlens-frontend.onrender.com)
# FRONTEND_URL=

# Max audit/compare requests per IP per 10 minutes (each scan can cost Apify credits)
# RATE_LIMIT_PER_10MIN=60

# true = skip all live scraping and serve canned demo-data (labelled as demo in the UI).
# Live scraping is the default.
DEMO_MODE=false
